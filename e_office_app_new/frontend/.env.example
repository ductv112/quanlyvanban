# ============================================
# QLVB Frontend — Environment Variables (Next.js)
# Copy file này thành .env.local rồi điền giá trị thật
#
# ⚠️ NEXT_PUBLIC_* variables được BAKE VÀO JS BUNDLE lúc `npm run build`
#    → Đổi giá trị PHẢI rebuild + restart pm2 mới có hiệu lực.
# ============================================

# ============================================================================
# NEXT_PUBLIC_API_URL — endpoint API backend
# ============================================================================
#
# DEV (localhost, 1 máy): trỏ thẳng port 4000
#   NEXT_PUBLIC_API_URL=http://localhost:4000/api
#
# PROD (KH access qua domain, IIS/Nginx reverse proxy /api/* → port 4000):
#   NEXT_PUBLIC_API_URL=/api    ← KHUYẾN NGHỊ (relative)
#
#   Lý do dùng relative `/api`:
#   - Browser tự dùng host hiện tại (https://prod.com hoặc http://ip)
#   - Tránh hard-code IP vào bundle → KH access domain HTTPS sẽ vỡ vì:
#     1. CORS reject (origin = domain ≠ allow IP)
#     2. Mixed content (HTTPS page → HTTP IP API call) — browser block
#
# PROD absolute (cross-domain, KHÔNG dùng reverse proxy chung):
#   NEXT_PUBLIC_API_URL=https://api.prod.com/api
#
# ❌ KHÔNG hard-code IP:
#   NEXT_PUBLIC_API_URL=http://103.97.134.87/api    ← sẽ vỡ khi đổi domain/HTTPS
#
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ============================================================================
# NEXT_PUBLIC_SOCKET_URL — Socket.IO server (realtime notifications)
# ============================================================================
#
# DEV: cùng host backend
#   NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
#
# PROD: relative WebSocket path qua reverse proxy (yêu cầu IIS/Nginx hỗ trợ
# WebSocket upgrade — IIS cần module WebSocket Protocol enabled)
#   NEXT_PUBLIC_SOCKET_URL=/    (cùng origin)
#
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
