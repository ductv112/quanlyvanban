# QLVB Test Environment - Template
# Copy file nay thanh .env.test:
#   Windows: Copy-Item .env.test.example .env.test
#   Linux:   cp .env.test.example .env.test
#
# Test DB tach hoan toan khoi dev DB (qlvb_test vs qlvb_dev)

# --- Server ---
NODE_ENV=test
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL TEST DB (qlvb_test, KHONG dung qlvb_dev) ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=qlvb_test
PG_USER=qlvb_admin
PG_PASSWORD=QlvbDev@2026
PG_MAX_CONNECTIONS=10
# Windows + Docker Desktop: explicit set container name de skip auto-detect probe
# (test-db-reset.ts auto-detect Docker tren Windows tu Phase 21-07, nhung explicit nhanh hon ~50ms)
# Linux: comment dong nay neu psql CLI native (CI ubuntu-latest)
PG_DOCKER_CONTAINER=qlvb_postgres

# --- MongoDB ---
MONGODB_URI=mongodb://qlvb_admin:QlvbMongo@2026@localhost:27017/qlvb_logs_test?authSource=admin

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=QlvbRedis@2026

# --- MinIO ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=qlvb_admin
MINIO_SECRET_KEY=QlvbMinio@2026
MINIO_USE_SSL=false
MINIO_BUCKET=documents-test

# --- JWT ---
JWT_SECRET=qlvb-test-jwt-secret-32chars-fixed-for-deterministic-testing
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
SIGNING_SECRET_KEY=qlvb-test-signing-key-32chars-fixed-for-deterministic-tests

# --- Mock servers (plan 21-03) ---
SMARTCA_BASE_URL=http://localhost:8181
MYSIGN_BASE_URL=http://localhost:8182
LGSP_ENDPOINT=http://localhost:8183
SIGNING_MOCK_MODE=true
MOCK_EXTERNAL=true

# --- Playwright ---
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_API_URL=http://localhost:4000
