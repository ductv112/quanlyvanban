# ============================================
# QLVB Backend — Environment Variables
# Copy file này thành .env rồi điền giá trị thật
# ============================================

# --- Server ---
PORT=4000
NODE_ENV=development

# CORS_ORIGIN — origin của frontend được phép gọi API
#
# DEV (1 máy): http://localhost:3000
#
# PROD: comma-separated NHIỀU origin (mỗi domain/protocol KH có thể access):
#   CORS_ORIGIN=https://doanhnghiep.vatk.org,http://doanhnghiep.vatk.org,http://103.97.134.87
#
#   Lý do nhiều origin:
#   - HTTPS + HTTP cùng domain (chưa có cert → vẫn allow HTTP)
#   - Domain + IP raw (devops/admin truy cập trực tiếp IP để debug)
#   - Subdomain khác (api.prod.com, admin.prod.com nếu có)
#
# ⚠️ Đổi giá trị → PHẢI `pm2 restart all --update-env` mới có hiệu lực.
# ⚠️ KHÔNG dùng `*` ở production — security risk (cho phép mọi origin).
#
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=qlvb_dev
PG_USER=qlvb_admin
PG_PASSWORD=QlvbDev@2026
PG_MAX_CONNECTIONS=20

# --- MongoDB (Log & Audit) ---
MONGODB_URI=mongodb://qlvb_admin:QlvbMongo@2026@localhost:27017/qlvb_logs?authSource=admin

# --- Redis (Cache + BullMQ) ---
# Redis dùng cho:
#   1. Cache (lib/redis/client.ts) — hash sessions, rate limits
#   2. BullMQ backing store (lib/queue/*) — LGSP, notification, signing queue (Phase 11+)
#
# Có thể dùng 1 trong 2 cách cấu hình:
#   - REDIS_URL (URI, ưu tiên cho production): redis://[:password@]host:port[/db]
#   - REDIS_HOST + REDIS_PORT + REDIS_PASSWORD (legacy/dev, dưới đây)
#
# Khi deploy production: khuyến nghị Redis persistent (appendonly yes) để job
# signing survive khi Redis restart — BullMQ dựa vào Redis data để resume
# pending poll jobs (3 phút window per sign transaction).
# REDIS_URL=redis://:password@redis-host:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=QlvbRedis@2026

# --- MinIO (File Storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=qlvb_admin
MINIO_SECRET_KEY=QlvbMinio@2026
MINIO_USE_SSL=false
MINIO_BUCKET=documents

# --- JWT Auth ---
# DEV ONLY — production phải đổi sang random secret 32+ chars
JWT_SECRET=qlvb-dev-jwt-secret-change-in-production-32chars
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES=7d

# --- Signing (pgcrypto key for client_secret encryption — Phase 8+) ---
# Key dùng để pgp_sym_encrypt/decrypt provider client_secret trong DB.
# Tối thiểu 16 ký tự (khuyến nghị 32+ ký tự ngẫu nhiên).
# Mất key = không decrypt được client_secret đã lưu — BACKUP KEY an toàn!
# DEV ONLY — production phải đổi
SIGNING_SECRET_KEY=qlvb-dev-signing-key-change-in-production-32chars

# --- SmartCA VNPT Tích hợp — DEV TEST ONLY ---
# User-level credentials cho provider SMARTCA_VNPT_TH (gói tích hợp dùng TOTP, không cần app mobile).
# Default lấy từ Java sample của VNPT (docs/huong_dan_tich_hop_ky_so_SmartCA_tich_hop/Java_example_SmartCA_tichhop-20251021).
# User 162952530 có 3 cert active trên endpoint prod gwsca.vnpt.vn (sandbox rmgateway.vnptit.vn KHÔNG có cert demo).
# Provider này CHỈ dùng cho dev verify Node.js code đúng chuẩn PAdES, KHÔNG bật cho khách hàng cuối.
SMARTCA_TH_USER_ID=162952530
SMARTCA_TH_USER_PASSWORD=123456a@A
SMARTCA_TH_TOTP_SECRET=NkY4QzYxRkU3QzZFMDZCNTZGN0UyQjIyNzZBQ0RBQzg=

# --- LGSP (Phase 18 + 37.3) — để mock cho dev, chỉ set thật khi production ---
MOCK_EXTERNAL=true
#
# Phase 37.3 (2026-05-22): LGSP truc Lang Son yeu cau login admin de lay Bearer token
# tu /v1/auth/login, sau do moi goi cac API per-DN (X-SystemId/X-SecretKey). 6 DN Lang Son
# dung CHUNG 1 admin user per environment (sandbox vs prod khac user).
#
# Per-env admin credentials (KHUYEN NGHI):
# LGSP_SANDBOX_USERNAME=adminlt01
# LGSP_SANDBOX_PASSWORD=
# LGSP_SANDBOX_APPLICATION_CODE=edoc-langson
# LGSP_PROD_USERNAME=adminlt_qlvbdn
# LGSP_PROD_PASSWORD=
# LGSP_PROD_APPLICATION_CODE=edoc-langson
#
# Legacy fallback (Phase 18 backward compat — chi dung khi LgspCredentials.environment=undefined):
# LGSP_ENDPOINT=https://apiltvb.langson.gov.vn
# LGSP_USERNAME=
# LGSP_PASSWORD=
# LGSP_APPLICATION_CODE=
# LGSP_SYSTEM_ID=
# LGSP_SECRET_KEY=

# --- LibreOffice (preview file Office — convert sang PDF) ---
# Tinh nang "Xem truc tiep file dinh kem" can LibreOffice headless de convert
# file Word/Excel/PowerPoint sang PDF, sau do stream PDF ve browser.
# Windows mac dinh: C:\Program Files\LibreOffice\program\soffice.com (BAT BUOC .com khong phai .exe)
# Linux mac dinh: /usr/bin/soffice
# LUU Y: Tren Windows phai dung soffice.com (console wrapper) — soffice.exe la GUI binary
# detach background, spawn return ngay khi chua kip tao PDF -> convert fail im lang.
# Code da auto-swap .exe -> .com de phong nguoi config nham.
LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com
